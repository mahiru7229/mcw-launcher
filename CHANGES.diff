+                "fileId": "b",
+                "fileName": "b.jar",
+                "path": "mods/b.jar",
+                "md5": "A" * 32,
+                "urls": ["https://one.example/b.jar", "https://one.example/b.jar"],
+                "pendingDownload": True,
+            },
+            {"fileId": "bad", "fileName": "bad.jar", "path": "../bad.jar"},
