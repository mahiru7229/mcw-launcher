+    version = SimpleNamespace(
+        main_class="net.minecraft.launchwrapper.Launch",
+        raw_json={"forge": {"gameVersion": "1.6.4", "loaderVersion": "9.11.1.1345"}},
+    )
+
+    result = ForgeLaunchCommandManager.prepare(version, ["-Xmx2G"])
+
