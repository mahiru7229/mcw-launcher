+def test_registry_round_trip_normalizes_managed_files(tmp_path: Path) -> None:
+    ATLauncherPackRegistry.save(tmp_path, {
+        "packId": "25",
+        "safeName": "ExamplePack",
+        "versionId": "101",
+        "versionName": "2.0.0",
+        "managedFiles": [
