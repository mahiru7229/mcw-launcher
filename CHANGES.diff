+            "-Dfml.ignoreInvalidMinecraftCertificates=false",
+            "-Xmx2G",
+            "-Dfml.ignoreInvalidMinecraftCertificates=true",
+        ],
+    )
+
+    assert result == ["-Dfml.ignoreInvalidMinecraftCertificates=true", "-Xmx2G"]
