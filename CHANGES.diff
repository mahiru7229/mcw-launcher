+        ModProvenanceRegistry.remove_by_filenames(instance, removed_names)
+        return tuple(messages)
+
+    @staticmethod
+    def _project_matches_mod_id(project, mod_id: str) -> bool:
+        identity = ModpackDependencyResolver._canonical_identity(mod_id)
